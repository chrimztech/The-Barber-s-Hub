# --- Server -------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Public URL of this API (used to build image URLs for uploads).
PUBLIC_API_URL=http://localhost:4000

# URL of the storefront (used in password reset emails).
APP_URL=http://localhost:8080

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:8080,http://localhost:3000,http://localhost:5173

# --- Database -----------------------------------------------------------------
# Example: postgres://postgres:password@localhost:5432/barbers_hub
DATABASE_URL=postgres://postgres:password@localhost:5432/barbers_hub
# Set to true for hosted databases that require TLS (Neon, Render, Railway...)
DATABASE_SSL=false

# --- Auth ---------------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# First admin account, created/promoted by `npm run seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Studio Admin

# --- Uploads ------------------------------------------------------------------
# Directory where uploaded images are stored (must be persistent in production).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Email (optional) -----------------------------------------------------------
# Without SMTP settings, password reset links are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Deepcuts Hair Studio <no-reply@example.com>"
# Where new booking/order alerts go (defaults to the business email in Settings).
STUDIO_NOTIFY_EMAIL=

# --- Bookings -------------------------------------------------------------------
# Studio time zone; bookings for times that have already passed today are rejected.
TIMEZONE=Africa/Lusaka

# --- Google sign-in (optional) ----------------------------------------------------
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <PUBLIC_API_URL>/api/auth/google/callback
# The "Continue with Google" button only appears when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
